# syntax=docker/dockerfile:1
# Builds the web CRM (Next.js) into a small image that runs as an unprivileged user.
#
# API_URL is where this container reaches the API. Next.js fixes the /api/v1 pass-through when it
# builds, so give it at build time (the compose file does):  --build-arg API_URL=http://api:3001
# The NEXT_PUBLIC_* values (product name, sign-in wording, support email) are also fixed at build time.

FROM node:24-bookworm-slim AS build
ENV CI=true
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @ah/web...
COPY apps/web apps/web
ARG API_URL=http://api:3001
ARG NEXT_PUBLIC_PRODUCT_NAME
ARG NEXT_PUBLIC_LOGIN_EYEBROW
ARG NEXT_PUBLIC_LOGIN_TITLE
ARG NEXT_PUBLIC_LOGIN_TAGLINE
ARG NEXT_PUBLIC_SUPPORT_EMAIL
ARG NEXT_PUBLIC_USER_MANUAL_URL
ARG NEXT_PUBLIC_HELP_URL
ARG NEXT_PUBLIC_WS_URL
ENV API_URL=$API_URL \
    NEXT_PUBLIC_PRODUCT_NAME=$NEXT_PUBLIC_PRODUCT_NAME \
    NEXT_PUBLIC_LOGIN_EYEBROW=$NEXT_PUBLIC_LOGIN_EYEBROW \
    NEXT_PUBLIC_LOGIN_TITLE=$NEXT_PUBLIC_LOGIN_TITLE \
    NEXT_PUBLIC_LOGIN_TAGLINE=$NEXT_PUBLIC_LOGIN_TAGLINE \
    NEXT_PUBLIC_SUPPORT_EMAIL=$NEXT_PUBLIC_SUPPORT_EMAIL \
    NEXT_PUBLIC_USER_MANUAL_URL=$NEXT_PUBLIC_USER_MANUAL_URL \
    NEXT_PUBLIC_HELP_URL=$NEXT_PUBLIC_HELP_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @ah/web build

FROM node:24-bookworm-slim AS run
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
