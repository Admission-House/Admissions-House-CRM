{
  "expo": {
    "name": "Admissions House CRM",
    "slug": "admissions-house-crm",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "admissionshouse",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#073c3a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.admissionshouse.crm",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used only to check that you are at the office when you sign in."
      }
    },
    "android": {
      "package": "com.admissionshouse.crm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#073c3a"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used only to check that you are at the office when you sign in."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera is used only to photograph a student's documents, such as an Aadhaar card or a certificate, to upload them to the CRM.",
          "photosPermission": "Photos are used only to choose a student's document or photo to upload to the CRM.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0f625e",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
