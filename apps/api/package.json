{
  "name": "@ah/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file=.env\"",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:migrate": "node --env-file=.env db/migrate.mjs",
    "db:types": "kysely-codegen --dialect postgres --url \"env(DATABASE_URL)\" --env-file .env --type-mapping \"{\\\"date\\\":\\\"string\\\"}\" --out-file src/database/db.d.ts",
    "tenant:provision": "node --env-file=.env db/provision-tenant.mjs",
    "load-test": "vitest run --config ./vitest.config.perf.ts",
    "db:seed-locations": "node --env-file=.env db/seed-locations.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "read-excel-file": "^9.3.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autocannon": "^8.0.0",
    "eslint": "^10.13.0",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
