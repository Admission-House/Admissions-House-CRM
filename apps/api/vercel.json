{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,node_modules/@fontsource/noto-sans/files/*latin-{400,700}-normal.woff,node_modules/@fontsource/noto-sans-devanagari/files/*devanagari-devanagari-{400,700}-normal.woff}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    { "path": "/api/v1/internal/jobs/minute", "schedule": "30-59 4 * * 1-6" },
    { "path": "/api/v1/internal/jobs/minute", "schedule": "* 5-12 * * 1-6" },
    { "path": "/api/v1/internal/jobs/minute", "schedule": "0-30 13 * * 1-6" },
    { "path": "/api/v1/internal/jobs/quarter", "schedule": "30,45 4 * * 1-6" },
    { "path": "/api/v1/internal/jobs/quarter", "schedule": "*/15 5-12 * * 1-6" },
    { "path": "/api/v1/internal/jobs/quarter", "schedule": "0,15,30 13 * * 1-6" },
    { "path": "/api/v1/internal/jobs/daily", "schedule": "30 20 * * *" }
  ]
}
