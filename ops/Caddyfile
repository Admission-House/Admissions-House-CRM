# HTTPS in front of the CRM, on the same machine as docker-compose.yml. Caddy gets and renews the
# certificate by itself. Replace crm.example.com with the real address (its DNS must point here).
#
#   /api/v1/*  goes straight to the API (this includes the /api/v1/ws WebSocket and the lead and
#              call webhooks), so the API sees the real address of every visitor.
#   the rest   goes to the web CRM.
#
# Set TRUST_PROXY_HOPS=1 in .env.production, because exactly one proxy (this one) sits in front.
crm.example.com {
	encode zstd gzip

	@api path /api/v1/*
	handle @api {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		-Server
	}
}

# The public product website (the "site" service). Replace www.example.com with its real address.
www.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3100
	header {
		-Server
	}
}
