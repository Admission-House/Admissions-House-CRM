# Copy to ../.env.production (next to docker-compose.yml) and fill in every value.
# Never commit the real file. Generate each secret; never reuse one.
#   32 random hex bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Database passwords (any long random text) ---
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# --- Secrets ---
JWT_ACCESS_SECRET=          # 32+ characters
DATA_ENCRYPTION_KEY=        # exactly 64 hex characters. BACK IT UP somewhere safe and separate.

# --- Addresses ---
CORS_ORIGINS=https://crm.example.com
WEB_URL=https://crm.example.com
TRUST_PROXY_HOPS=1          # one proxy (Caddy) in front

# --- Email (needed for forgot-password) ---
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Admissions House CRM <no-reply@yourdomain>"

# --- Phone alerts: leave off until the mobile app phase ---
PUSH_PROVIDER=off

# --- Files (documents and call recordings) ---
# Default is a folder inside the container volume. For S3, Cloudflare R2 or DigitalOcean Spaces:
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional: the colleges provider's API, if they give one (otherwise import the Excel file) ---
# COLLEGE_API_URL=
# COLLEGE_API_KEY=

# --- Optional: lets a monitoring tool read /api/v1/metrics ---
# METRICS_TOKEN=            # 16+ characters

# --- Branding of the sign-in screen (fixed when the web image is built) ---
# NEXT_PUBLIC_PRODUCT_NAME=Admissions House CRM
# NEXT_PUBLIC_SUPPORT_EMAIL=
