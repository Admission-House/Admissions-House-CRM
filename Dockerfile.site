# syntax=docker/dockerfile:1
# Builds the public product website (Next.js) into a small image that runs as an unprivileged user.
#
# The company details (SITE_NAME, SITE_PHONE, ...) are put into the pages when they are built, so give
# them as build arguments (the compose file does). CRM_WEBHOOK_URL and CRM_WEBHOOK_SECRET are read when
# the container runs.

FROM node:24-bookworm-slim AS build
ENV CI=true
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/site/package.json apps/site/
RUN pnpm install --frozen-lockfile --filter @ah/site...
COPY apps/site apps/site
ARG SITE_NAME
ARG SITE_COMPANY
ARG SITE_URL
ARG SITE_EMAIL
ARG SITE_PHONE
ARG SITE_ADDRESS
ARG SITE_HOURS
ENV SITE_NAME=$SITE_NAME \
    SITE_COMPANY=$SITE_COMPANY \
    SITE_URL=$SITE_URL \
    SITE_EMAIL=$SITE_EMAIL \
    SITE_PHONE=$SITE_PHONE \
    SITE_ADDRESS=$SITE_ADDRESS \
    SITE_HOURS=$SITE_HOURS \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @ah/site build

FROM node:24-bookworm-slim AS run
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3100 \
    HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/site/.next/standalone ./
COPY --from=build --chown=node:node /repo/apps/site/.next/static ./apps/site/.next/static
COPY --from=build --chown=node:node /repo/apps/site/public ./apps/site/public
USER node
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3100/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/site/server.js"]
